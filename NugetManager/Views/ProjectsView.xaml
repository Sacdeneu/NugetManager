<UserControl x:Class="NugetManager.Views.ProjectsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:NugetManager.ViewModels"
             xmlns:h="clr-namespace:NugetManager.Helpers"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:ProjectsViewModel, IsDesignTimeCreatable=False}">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Topbar -->
        <Border Grid.Row="0" Padding="18,12"
                BorderBrush="{DynamicResource BorderLightBrush}" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Projets Visual Studio" FontSize="15" FontWeight="Medium"
                               Foreground="{DynamicResource TextBrush}"/>
                    <TextBlock Text="Gérez vos sources NuGet par projet" FontSize="11"
                               Foreground="{DynamicResource TextBrush}" Opacity="0.5" Margin="0,2,0,0"/>
                </StackPanel>
                <Button Grid.Column="1" Content="+ Ajouter projet"
                        Command="{Binding BrowseFolderCommand}"
                        Style="{StaticResource AccentButtonStyle}" Padding="13,5" FontSize="12"/>
            </Grid>
        </Border>

        <!-- Split panel -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="230"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ── Left: Projects list ──────────────────────────────────── -->
            <Border Grid.Column="0"
                    BorderBrush="{DynamicResource BorderLightBrush}" BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Header -->
                    <Border Grid.Row="0" Padding="13,8"
                            BorderBrush="{DynamicResource BorderLightBrush}" BorderThickness="0,0,0,0.5"
                            Background="{DynamicResource ControlDarkBrush}">
                        <Grid>
                            <TextBlock Text="PROJETS" FontSize="10" FontWeight="Medium"
                                       Foreground="{DynamicResource TextBrush}" Opacity="0.5"
                                       VerticalAlignment="Center"/>
                            <Button Content="+" HorizontalAlignment="Right"
                                    Command="{Binding BrowseFolderCommand}"
                                    Background="{DynamicResource SystemAccentBrush}"
                                    Foreground="White" BorderThickness="0"
                                    Width="20" Height="20" FontSize="13" Padding="0"
                                    Cursor="Hand">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}"
                                                CornerRadius="4" Padding="{TemplateBinding Padding}">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </Grid>
                    </Border>

                    <!-- Project items -->
                    <ListBox Grid.Row="1"
                             ItemsSource="{Binding Projects}"
                             SelectedItem="{Binding SelectedProject}"
                             Background="Transparent" BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Padding" Value="13,9"/>
                                <Setter Property="Cursor" Value="Hand"/>
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="BorderBrush" Value="{DynamicResource BorderLightBrush}"/>
                                <Setter Property="BorderThickness" Value="0,0,0,0.5"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border Background="{TemplateBinding Background}"
                                                    BorderBrush="{TemplateBinding BorderBrush}"
                                                    BorderThickness="{TemplateBinding BorderThickness}"
                                                    Padding="{TemplateBinding Padding}">
                                                <ContentPresenter/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="#E6F1FB"/>
                                        <Setter Property="BorderThickness" Value="0,0,2,0.5"/>
                                        <Setter Property="BorderBrush" Value="#378ADD"/>
                                    </Trigger>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource ControlDarkBrush}"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="Medium"
                                               Foreground="{DynamicResource TextBrush}"
                                               TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding Path}" FontSize="10"
                                               Foreground="{DynamicResource TextBrush}" Opacity="0.4"
                                               TextTrimming="CharacterEllipsis" Margin="0,2,0,5"/>

                                    <!-- Badges -->
                                    <StackPanel Orientation="Horizontal">
                                        <!-- pkg count -->
                                        <Border CornerRadius="3" Padding="5,1" Margin="0,0,4,0"
                                                Background="{DynamicResource ControlDarkBrush}"
                                                BorderBrush="{DynamicResource BorderLightBrush}" BorderThickness="0.5">
                                            <TextBlock FontSize="10" Foreground="{DynamicResource TextBrush}" Opacity="0.7">
                                                <Run Text="{Binding TotalPackages, Mode=OneWay}"/><Run Text=" pkg"/>
                                            </TextBlock>
                                        </Border>

                                        <!-- MAJ count (only if > 0) -->
                                        <Border CornerRadius="3" Padding="5,1" Margin="0,0,4,0"
                                                Background="#FAEEDA">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding UpdatesAvailable}" Value="0">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock FontSize="10" Foreground="#633806">
                                                <Run Text="{Binding UpdatesAvailable, Mode=OneWay}"/><Run Text=" MAJ"/>
                                            </TextBlock>
                                        </Border>

                                        <!-- Source label -->
                                        <Border CornerRadius="3" Padding="5,1">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="{DynamicResource ControlDarkBrush}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsLocalFeedActive}" Value="True">
                                                            <Setter Property="Background" Value="#EAF3DE"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock FontSize="10">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Text" Value="nuget.org"/>
                                                        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                                                        <Setter Property="Opacity" Value="0.5"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsLocalFeedActive}" Value="True">
                                                                <Setter Property="Text" Value="local"/>
                                                                <Setter Property="Foreground" Value="#27500A"/>
                                                                <Setter Property="Opacity" Value="1"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>
                                    </StackPanel>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- Scan bar -->
                    <Border Grid.Row="2" Padding="10,8"
                            BorderBrush="{DynamicResource BorderLightBrush}" BorderThickness="0,1,0,0"
                            Background="{DynamicResource ControlDarkBrush}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" VerticalAlignment="Center" FontSize="11"
                                       Foreground="{DynamicResource TextBrush}" Opacity="0.5"
                                       TextTrimming="CharacterEllipsis">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="{Binding ScannedFolder}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ScannedFolder}" Value="">
                                                <Setter Property="Text" Value="Aucun dossier…"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <Button Grid.Column="1" Content="..." Command="{Binding BrowseFolderCommand}"
                                    Padding="6,3" FontSize="11" Margin="4,0"/>
                            <Button Grid.Column="2" Content="Scanner" Command="{Binding ScanFolderCommand}"
                                    Style="{StaticResource AccentButtonStyle}" Padding="8,3" FontSize="11"/>
                        </Grid>
                    </Border>

                    <!-- Loading overlay -->
                    <Border Grid.Row="0" Grid.RowSpan="3"
                            Background="{DynamicResource ControlLightBrush}" Opacity="0.85"
                            Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <ProgressBar IsIndeterminate="True" Width="80" Height="3" Margin="0,0,0,6"/>
                            <TextBlock Text="Scan..." FontSize="11" HorizontalAlignment="Center"
                                       Foreground="{DynamicResource TextBrush}" Opacity="0.6"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- ── Right: Project detail ────────────────────────────────── -->
            <Grid Grid.Column="1">

                <!-- Empty state -->
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedProject}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <TextBlock Text="◫" FontSize="22" HorizontalAlignment="Center"
                               Foreground="{DynamicResource TextBrush}" Opacity="0.2"/>
                    <TextBlock Text="Sélectionnez un projet" FontSize="12" Margin="0,6,0,0"
                               Foreground="{DynamicResource TextBrush}" Opacity="0.4"/>
                </StackPanel>

                <!-- Detail (when project selected) -->
                <Grid>
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Setter Property="Visibility" Value="Visible"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedProject}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Detail topbar -->
                    <Border Grid.Row="0" Padding="15,10"
                            BorderBrush="{DynamicResource BorderLightBrush}" BorderThickness="0,0,0,0.5">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="{Binding SelectedProject.Name}" FontSize="14" FontWeight="Medium"
                                           Foreground="{DynamicResource TextBrush}"/>
                                <TextBlock Text="{Binding SelectedProject.Path}" FontSize="10"
                                           Foreground="{DynamicResource TextBrush}" Opacity="0.4"
                                           TextTrimming="CharacterEllipsis" Margin="0,2,0,0" MaxWidth="400"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Button Content="Changer source" Command="{Binding ChangeSourceCommand}"
                                        Padding="9,3" FontSize="11" Margin="0,0,6,0"/>
                                <Button Content="📂" Command="{Binding OpenProjectFolderCommand}"
                                        Background="Transparent" BorderThickness="0"
                                        FontSize="14" Cursor="Hand" Padding="4,0"
                                        Foreground="{DynamicResource TextBrush}" ToolTip="Ouvrir dans l'explorateur"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Stats row -->
                    <Grid Grid.Row="1" Margin="15,10,15,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Margin="0,0,6,0"
                                BorderBrush="{DynamicResource BorderLightBrush}" BorderThickness="0.5"
                                CornerRadius="5" Padding="10,7">
                            <StackPanel>
                                <TextBlock Text="Packages" FontSize="10"
                                           Foreground="{DynamicResource TextBrush}" Opacity="0.5" Margin="0,0,0,2"/>
                                <TextBlock Text="{Binding SelectedTotalPackages}" FontSize="19" FontWeight="Medium"
                                           Foreground="{DynamicResource TextBrush}"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="1" Margin="0,0,6,0"
                                BorderBrush="{DynamicResource BorderLightBrush}" BorderThickness="0.5"
                                CornerRadius="5" Padding="10,7">
                            <StackPanel>
                                <TextBlock Text="À jour" FontSize="10"
                                           Foreground="{DynamicResource TextBrush}" Opacity="0.5" Margin="0,0,0,2"/>
                                <TextBlock Text="{Binding SelectedUpToDateCount}" FontSize="19" FontWeight="Medium"
                                           Foreground="#3B6D11"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="2" Margin="0,0,6,0"
                                BorderBrush="{DynamicResource BorderLightBrush}" BorderThickness="0.5"
                                CornerRadius="5" Padding="10,7">
                            <StackPanel>
                                <TextBlock Text="Mises à jour" FontSize="10"
                                           Foreground="{DynamicResource TextBrush}" Opacity="0.5" Margin="0,0,0,2"/>
                                <TextBlock Text="{Binding SelectedUpdatesCount}" FontSize="19" FontWeight="Medium"
                                           Foreground="#854F0B"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="3"
                                BorderBrush="{DynamicResource BorderLightBrush}" BorderThickness="0.5"
                                CornerRadius="5" Padding="10,7">
                            <StackPanel>
                                <TextBlock Text="Source active" FontSize="10"
                                           Foreground="{DynamicResource TextBrush}" Opacity="0.5" Margin="0,0,0,2"/>
                                <TextBlock Text="{Binding SelectedActiveSource}" FontSize="12" FontWeight="Medium"
                                           Foreground="{DynamicResource TextBrush}" FontFamily="Consolas"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Updates banner -->
                    <Border Grid.Row="2" Padding="14,7"
                            Background="#FAEEDA"
                            BorderBrush="#EF9F27" BorderThickness="0,0.5,0,0.5"
                            Visibility="{Binding HasUpdates, Converter={StaticResource BoolToVis}}">
                        <Grid>
                            <TextBlock FontSize="11" Foreground="#633806" VerticalAlignment="Center">
                                <Run Text="{Binding SelectedUpdatesCount, Mode=OneWay}"/>
                                <Run Text=" package(s) peuvent être mis à jour"/>
                            </TextBlock>
                            <Button Content="Tout mettre à jour" HorizontalAlignment="Right"
                                    Command="{Binding UpdateAllCommand}"
                                    FontSize="11" Padding="9,3"
                                    Background="#EF9F27" Foreground="White" BorderThickness="0"
                                    Cursor="Hand">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}"
                                                CornerRadius="4" Padding="{TemplateBinding Padding}">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </Grid>
                    </Border>

                    <!-- Filter bar -->
                    <Border Grid.Row="3" Padding="15,8"
                            BorderBrush="{DynamicResource BorderLightBrush}" BorderThickness="0,0,0,0.5">
                        <TextBox Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged}"
                                 FontSize="12" Padding="6,5"/>
                    </Border>

                    <!-- Package table -->
                    <ListView Grid.Row="4"
                              ItemsSource="{Binding FilteredPackages}"
                              Background="Transparent" BorderThickness="0"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListView.View>
                            <GridView>
                                <GridView.ColumnHeaderContainerStyle>
                                    <Style TargetType="GridViewColumnHeader">
                                        <Setter Property="Background" Value="{DynamicResource ControlDarkBrush}"/>
                                        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                                        <Setter Property="Opacity" Value="0.6"/>
                                        <Setter Property="FontSize" Value="10"/>
                                        <Setter Property="FontWeight" Value="Medium"/>
                                        <Setter Property="Padding" Value="12,6"/>
                                        <Setter Property="BorderThickness" Value="0,0,0,0.5"/>
                                        <Setter Property="BorderBrush" Value="{DynamicResource BorderLightBrush}"/>
                                        <Setter Property="HorizontalContentAlignment" Value="Left"/>
                                    </Style>
                                </GridView.ColumnHeaderContainerStyle>

                                <GridViewColumn Header="PACKAGE" Width="240">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <Border Width="16" Height="16" CornerRadius="3" Margin="0,0,8,0"
                                                        Background="{DynamicResource ControlDarkBrush}"
                                                        BorderBrush="{DynamicResource BorderLightBrush}" BorderThickness="0.5">
                                                    <TextBlock Text="N" FontSize="9" FontWeight="Bold"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                                               Foreground="{DynamicResource SystemAccentBrush}"/>
                                                </Border>
                                                <TextBlock Text="{Binding Id}" FontSize="12"
                                                           Foreground="{DynamicResource TextBrush}"
                                                           VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>

                                <GridViewColumn Header="VERSION ACTUELLE" Width="130">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Version}" FontFamily="Consolas" FontSize="11"
                                                       Foreground="{DynamicResource TextBrush}"/>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>

                                <GridViewColumn Header="DERNIÈRE VERSION" Width="140">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock FontFamily="Consolas" FontSize="11">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Text" Value="{Binding LatestVersion}"/>
                                                        <Setter Property="Foreground" Value="#3B6D11"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding NeedsUpdate}" Value="True">
                                                                <Setter Property="Foreground" Value="#854F0B"/>
                                                                <Setter Property="FontWeight" Value="Medium"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>

                                <GridViewColumn Header="SOURCE" Width="130">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding LatestSource}" FontSize="11">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                                                        <Setter Property="Opacity" Value="0.5"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding ExistsLocally}" Value="True">
                                                                <Setter Property="Foreground" Value="#185FA5"/>
                                                                <Setter Property="Opacity" Value="1"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>

                                <GridViewColumn Header="ACTIONS" Width="100">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <!-- Update button (only if needs update) -->
                                                <Button Padding="6,2" FontSize="11" Margin="0,0,4,0"
                                                        Command="{Binding DataContext.UpdatePackageCommand, RelativeSource={RelativeSource AncestorType=ListView}}"
                                                        CommandParameter="{Binding}"
                                                        Visibility="{Binding NeedsUpdate, Converter={StaticResource BoolToVis}}">
                                                    <Button.Style>
                                                        <Style TargetType="Button">
                                                            <Setter Property="Content" Value="↑ MAJ"/>
                                                            <Setter Property="Foreground" Value="#633806"/>
                                                            <Setter Property="Background" Value="Transparent"/>
                                                            <Setter Property="BorderBrush" Value="#BA7517"/>
                                                            <Setter Property="BorderThickness" Value="0.5"/>
                                                            <Setter Property="Cursor" Value="Hand"/>
                                                            <Setter Property="Template">
                                                                <Setter.Value>
                                                                    <ControlTemplate TargetType="Button">
                                                                        <Border Background="{TemplateBinding Background}"
                                                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                                                CornerRadius="4" Padding="{TemplateBinding Padding}">
                                                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                                        </Border>
                                                                        <ControlTemplate.Triggers>
                                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                                <Setter Property="Background" Value="#FAEEDA"/>
                                                                            </Trigger>
                                                                        </ControlTemplate.Triggers>
                                                                    </ControlTemplate>
                                                                </Setter.Value>
                                                            </Setter>
                                                        </Style>
                                                    </Button.Style>
                                                </Button>

                                                <!-- Delete button -->
                                                <Button Content="×" FontSize="14" Padding="4,0"
                                                        Background="Transparent" BorderThickness="0"
                                                        Foreground="{DynamicResource TextBrush}" Opacity="0.3"
                                                        Cursor="Hand" ToolTip="Retirer du .csproj">
                                                    <Button.Style>
                                                        <Style TargetType="Button">
                                                            <Setter Property="Template">
                                                                <Setter.Value>
                                                                    <ControlTemplate TargetType="Button">
                                                                        <TextBlock Text="×" FontSize="14"
                                                                                   Foreground="{TemplateBinding Foreground}"
                                                                                   Opacity="{TemplateBinding Opacity}"/>
                                                                        <ControlTemplate.Triggers>
                                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                                <Setter Property="Foreground" Value="#A32D2D"/>
                                                                                <Setter Property="Opacity" Value="1"/>
                                                                            </Trigger>
                                                                        </ControlTemplate.Triggers>
                                                                    </ControlTemplate>
                                                                </Setter.Value>
                                                            </Setter>
                                                        </Style>
                                                    </Button.Style>
                                                </Button>
                                            </StackPanel>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                            </GridView>
                        </ListView.View>

                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="BorderThickness" Value="0,0,0,0.5"/>
                                <Setter Property="BorderBrush" Value="{DynamicResource BorderLightBrush}"/>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource ControlDarkBrush}"/>
                                    </Trigger>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="Transparent"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </ListView.ItemContainerStyle>
                    </ListView>

                    <!-- Status bar -->
                    <TextBlock Grid.Row="5" Text="{Binding StatusMessage}"
                               Foreground="{DynamicResource TextBrush}" Opacity="0.5"
                               FontSize="11" Margin="15,6"/>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
