<UserControl x:Class="NugetManager.Views.PackagesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:NugetManager.ViewModels"
             xmlns:h="clr-namespace:NugetManager.Helpers"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:PackagesViewModel, IsDesignTimeCreatable=False}">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Topbar -->
        <Border Grid.Row="0" Padding="18,12"
                BorderBrush="{DynamicResource BorderLightBrush}" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Vertical" h:SpacingHelper.Spacing="2">
                    <TextBlock Text="Packages locaux" FontSize="15" FontWeight="Medium"
                               Foreground="{DynamicResource TextBrush}"/>
                    <TextBlock FontSize="11" Foreground="{DynamicResource TextBrush}" Opacity="0.5">
                        <Run Text="Serveur local · localhost:"/>
                        <Run Text="{Binding ServerPort}"/>
                    </TextBlock>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" h:SpacingHelper.Spacing="7">
                    <Button Content="Actualiser" Command="{Binding LoadPackagesCommand}" Padding="13,5" FontSize="12"/>
                    <Button Content="+ Upload .nupkg" Command="{Binding UploadPackageCommand}"
                            Style="{StaticResource AccentButtonStyle}" Padding="13,5" FontSize="12"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main content -->
        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Stats row -->
            <Grid Grid.Row="0" Margin="18,13,18,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="{DynamicResource ControlDarkBrush}"
                        CornerRadius="6" BorderBrush="{DynamicResource BorderLightBrush}" BorderThickness="0.5"
                        Padding="11,8">
                    <StackPanel>
                        <TextBlock Text="Packages" FontSize="10" Foreground="{DynamicResource TextBrush}"
                                   Opacity="0.55" Margin="0,0,0,3"/>
                        <TextBlock Text="{Binding UniquePackagesCount}" FontSize="19" FontWeight="Medium"
                                   Foreground="{DynamicResource TextBrush}"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Background="{DynamicResource ControlDarkBrush}"
                        CornerRadius="6" BorderBrush="{DynamicResource BorderLightBrush}" BorderThickness="0.5"
                        Padding="11,8">
                    <StackPanel>
                        <TextBlock Text="Versions" FontSize="10" Foreground="{DynamicResource TextBrush}"
                                   Opacity="0.55" Margin="0,0,0,3"/>
                        <TextBlock Text="{Binding TotalVersionsCount}" FontSize="19" FontWeight="Medium"
                                   Foreground="{DynamicResource TextBrush}"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="4" Background="{DynamicResource ControlDarkBrush}"
                        CornerRadius="6" BorderBrush="{DynamicResource BorderLightBrush}" BorderThickness="0.5"
                        Padding="11,8">
                    <StackPanel>
                        <TextBlock Text="Taille totale" FontSize="10" Foreground="{DynamicResource TextBrush}"
                                   Opacity="0.55" Margin="0,0,0,3"/>
                        <TextBlock Text="{Binding TotalSizeFormatted}" FontSize="15" FontWeight="Medium"
                                   Foreground="{DynamicResource TextBrush}" Margin="0,2,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Search row -->
            <Grid Grid.Row="1" Margin="18,10,18,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="140"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBox Grid.Column="0" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                         Margin="0,0,7,0" Padding="8,6" FontSize="12">
                    <TextBox.InputBindings>
                        <KeyBinding Key="Return" Command="{Binding LoadPackagesCommand}"/>
                    </TextBox.InputBindings>
                </TextBox>

                <ComboBox Grid.Column="1" ItemsSource="{Binding AllTags}"
                          SelectedItem="{Binding FilterTag}"
                          Margin="0,0,7,0" FontSize="12"/>

                <Button Grid.Column="2" Content="Filtrer" Command="{Binding FilterByTagCommand}"
                        Padding="13,5" FontSize="12"/>
            </Grid>

            <!-- Two panels -->
            <Grid Grid.Row="2" Margin="18,0,18,18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.3*"/>
                    <ColumnDefinition Width="11"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Left: package list panel -->
                <Border Grid.Column="0"
                        BorderBrush="{DynamicResource BorderLightBrush}" BorderThickness="0.5"
                        CornerRadius="6" ClipToBounds="True">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Panel header -->
                        <Border Grid.Row="0" Padding="12,8"
                                Background="{DynamicResource ControlDarkBrush}"
                                BorderBrush="{DynamicResource BorderLightBrush}" BorderThickness="0,0,0,0.5">
                            <Grid>
                                <TextBlock Text="PACKAGE" FontSize="10" FontWeight="Medium"
                                           Foreground="{DynamicResource TextBrush}" Opacity="0.5"
                                           VerticalAlignment="Center"/>
                                <TextBlock Text="VERSION" FontSize="10" FontWeight="Medium"
                                           Foreground="{DynamicResource TextBrush}" Opacity="0.5"
                                           HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>

                        <!-- List -->
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding Packages}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border x:Name="PkgRow"
                                                Padding="11,8" Cursor="Hand"
                                                BorderBrush="{DynamicResource BorderLightBrush}" BorderThickness="0,0,0,0.5">
                                            <Border.InputBindings>
                                                <MouseBinding MouseAction="LeftClick"
                                                              Command="{Binding DataContext.SelectPackageCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                              CommandParameter="{Binding}"/>
                                            </Border.InputBindings>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="28"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <!-- Icon placeholder -->
                                                <Border Grid.Column="0" Width="28" Height="28" CornerRadius="5"
                                                        Background="{DynamicResource ControlDarkBrush}"
                                                        BorderBrush="{DynamicResource BorderLightBrush}" BorderThickness="0.5">
                                                    <TextBlock Text="⬡" FontSize="12" HorizontalAlignment="Center"
                                                               VerticalAlignment="Center"
                                                               Foreground="{DynamicResource TextBrush}" Opacity="0.4"/>
                                                </Border>

                                                <StackPanel Grid.Column="1" Margin="9,0,0,0" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Id}" FontSize="12" FontWeight="Medium"
                                                               Foreground="{DynamicResource TextBrush}"
                                                               TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock FontSize="11" Foreground="{DynamicResource TextBrush}"
                                                               Opacity="0.5" Margin="0,1,0,0"
                                                               TextTrimming="CharacterEllipsis">
                                                        <Run Text="{Binding Authors}"/>
                                                    </TextBlock>
                                                </StackPanel>

                                                <!-- Version badge -->
                                                <Border Grid.Column="2" CornerRadius="10" Padding="7,1"
                                                        VerticalAlignment="Center">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Background" Value="#EAF3DE"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsPreview}" Value="True">
                                                                    <Setter Property="Background" Value="#FAEEDA"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <TextBlock Text="{Binding Version}" FontSize="10" FontWeight="Medium">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Foreground" Value="#27500A"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsPreview}" Value="True">
                                                                        <Setter Property="Foreground" Value="#633806"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </Border>
                                            </Grid>

                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="Transparent"/>
                                                    <Style.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter Property="Background" Value="{DynamicResource ControlDarkBrush}"/>
                                                        </Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                        <!-- Loading overlay -->
                        <Border Grid.Row="0" Grid.RowSpan="2" CornerRadius="6"
                                Background="{DynamicResource ControlLightBrush}" Opacity="0.85"
                                Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <ProgressBar IsIndeterminate="True" Width="100" Height="3" Margin="0,0,0,8"/>
                                <TextBlock Text="Chargement..." FontSize="11"
                                           Foreground="{DynamicResource TextBrush}" Opacity="0.6"
                                           HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <!-- Right: detail panel -->
                <Border Grid.Column="2"
                        BorderBrush="{DynamicResource BorderLightBrush}" BorderThickness="0.5"
                        CornerRadius="6" ClipToBounds="True">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <Grid>
                            <!-- Empty state -->
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                                        Margin="0,60,0,0">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedPackage}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <TextBlock Text="⬡" FontSize="22" HorizontalAlignment="Center"
                                           Foreground="{DynamicResource TextBrush}" Opacity="0.2"/>
                                <TextBlock Text="Sélectionnez un package" FontSize="12" Margin="0,6,0,0"
                                           Foreground="{DynamicResource TextBrush}" Opacity="0.4"/>
                            </StackPanel>

                            <!-- Detail content -->
                            <StackPanel Margin="14" Visibility="{Binding SelectedPackage, Converter={StaticResource BoolToVis}}">
                                <!-- Header -->
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="38"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Width="38" Height="38" CornerRadius="7"
                                            Background="{DynamicResource ControlDarkBrush}"
                                            BorderBrush="{DynamicResource BorderLightBrush}" BorderThickness="0.5">
                                        <TextBlock Text="⬡" FontSize="17" HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   Foreground="{DynamicResource TextBrush}" Opacity="0.3"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding SelectedPackage.Id}" FontSize="14"
                                                   FontWeight="Medium" Foreground="{DynamicResource TextBrush}"
                                                   TextWrapping="Wrap"/>
                                        <TextBlock Text="{Binding SelectedPackage.Version}" FontSize="11"
                                                   Foreground="{DynamicResource TextBrush}" Opacity="0.5"
                                                   Margin="0,3,0,0"/>
                                    </StackPanel>
                                </Grid>

                                <!-- Description -->
                                <TextBlock Text="{Binding SelectedPackage.Description}" FontSize="12"
                                           Foreground="{DynamicResource TextBrush}" Opacity="0.65"
                                           TextWrapping="Wrap" LineHeight="18" Margin="0,0,0,12"/>

                                <!-- Metadata rows -->
                                <Border BorderBrush="{DynamicResource BorderLightBrush}" BorderThickness="0,0,0,0.5" Padding="0,4">
                                    <Grid>
                                        <TextBlock Text="Auteurs" FontSize="11" Foreground="{DynamicResource TextBrush}" Opacity="0.5"/>
                                        <TextBlock Text="{Binding SelectedPackage.Authors}" FontSize="11"
                                                   Foreground="{DynamicResource TextBrush}" HorizontalAlignment="Right"
                                                   TextTrimming="CharacterEllipsis" MaxWidth="140"/>
                                    </Grid>
                                </Border>
                                <Border BorderBrush="{DynamicResource BorderLightBrush}" BorderThickness="0,0,0,0.5" Padding="0,4">
                                    <Grid>
                                        <TextBlock Text="Taille" FontSize="11" Foreground="{DynamicResource TextBrush}" Opacity="0.5"/>
                                        <TextBlock Text="{Binding SelectedPackage.SizeFormatted}" FontSize="11"
                                                   Foreground="{DynamicResource TextBrush}" HorizontalAlignment="Right"/>
                                    </Grid>
                                </Border>
                                <Border BorderBrush="{DynamicResource BorderLightBrush}" BorderThickness="0,0,0,0.5" Padding="0,4" Margin="0,0,0,12">
                                    <Grid>
                                        <TextBlock Text="Publié" FontSize="11" Foreground="{DynamicResource TextBrush}" Opacity="0.5"/>
                                        <TextBlock Text="{Binding SelectedPackage.PublishedFormatted}" FontSize="11"
                                                   Foreground="{DynamicResource TextBrush}" HorizontalAlignment="Right"/>
                                    </Grid>
                                </Border>

                                <!-- Custom tags -->
                                <TextBlock Text="TAGS PERSONNALISÉS" FontSize="10" FontWeight="Medium"
                                           Foreground="{DynamicResource TextBrush}" Opacity="0.45"
                                           Margin="0,0,0,6"/>

                                <ItemsControl ItemsSource="{Binding SelectedPackage.CustomTags}" Margin="0,0,0,8">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="#E6F1FB" CornerRadius="10" Padding="7,1" Margin="0,0,4,4">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding}" FontSize="10" Foreground="#0C447C"/>
                                                    <Button Content="×" FontSize="10" Foreground="#0C447C"
                                                            Background="Transparent" BorderThickness="0"
                                                            Margin="4,0,0,0" Padding="0" Cursor="Hand"
                                                            Command="{Binding DataContext.RemoveTagCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}"/>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <Grid Margin="0,0,0,16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0" Text="{Binding NewTag, UpdateSourceTrigger=PropertyChanged}"
                                             Padding="6,5" FontSize="12" Margin="0,0,6,0">
                                        <TextBox.InputBindings>
                                            <KeyBinding Key="Return" Command="{Binding AddTagCommand}"/>
                                        </TextBox.InputBindings>
                                    </TextBox>
                                    <Button Grid.Column="1" Content="+" Command="{Binding AddTagCommand}"
                                            Style="{StaticResource AccentButtonStyle}" Width="30" Padding="0"/>
                                </Grid>

                                <!-- Actions -->
                                <Button Content="Supprimer ce package"
                                        Command="{Binding DeletePackageCommand}"
                                        Style="{StaticResource DangerButtonStyle}"
                                        HorizontalAlignment="Stretch" Padding="0,6" FontSize="12"/>
                            </StackPanel>
                        </Grid>
                    </ScrollViewer>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
